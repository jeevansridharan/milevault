# Supabase — use the ANON (public) key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_ORACLE_URL=http://localhost:3001

# Chain selection: mainnet (default) or chipnet for testing only.
VITE_BCH_NETWORK=mainnet
VITE_MAX_FUND_BCH=0.01
# CashToken category ID of a token configured on the selected network.
VITE_GOV_TOKEN_CATEGORY_ID=
