# MileVault Oracle Backend — Environment Variables
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env — it is listed in .gitignore.

# ── Supabase (server-side only — service role key bypasses RLS) ───────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Oracle signing key (private — never expose outside this file) ─────────────
# Generate a fresh key with: node scripts/gen-oracle.mjs
# Only the PUBLIC KEY is ever printed or stored in Supabase.
ORACLE_WIF=your_oracle_wif_here

# ── Server config ─────────────────────────────────────────────────────────────
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# ── Network (mainnet or chipnet) ──────────────────────────────────────────────
# BCH_NETWORK=mainnet   ← production
# BCH_NETWORK=chipnet   ← local testing only
BCH_NETWORK=mainnet
